{
  "info": {
    "_postman_id": "2ef28779-a908-4f75-aeb9-56e0fc339fac",
    "name": "Tech Challenge Fase 3 - Hospital Appointment Platform",
    "description": "Colecao Postman para testar agendamento (REST), historico (GraphQL), seguranca via JWT e health checks da plataforma hospitalar. Rode os logins no folder Auth primeiro para popular os tokens nas variaveis token_medico, token_enfermeiro e token_paciente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url_scheduling", "value": "http://localhost:8080/api/v1" },
    { "key": "base_url_scheduling_root", "value": "http://localhost:8080" },
    { "key": "base_url_history", "value": "http://localhost:8081" },
    { "key": "base_url_notification", "value": "http://localhost:8082" },
    { "key": "consulta_id", "value": "a087c948-0973-4d3e-bf82-e05510f34b64" },
    { "key": "token_medico", "value": "" },
    { "key": "token_enfermeiro", "value": "" },
    { "key": "token_paciente", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Scheduling health",
          "request": { "method": "GET", "url": "{{base_url_scheduling_root}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "History health",
          "request": { "method": "GET", "url": "{{base_url_history}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Notification health",
          "request": { "method": "GET", "url": "{{base_url_notification}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login medico",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{medico_username}}\",\n  \"senha\": \"{{medico_password}}\"\n}" },
            "url": "{{base_url_scheduling}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.test('token retornado', () => pm.expect(body.token).to.be.a('string').and.not.empty);", "pm.test('tipo Bearer', () => pm.expect(body.tipo).to.eql('Bearer'));", "pm.collectionVariables.set('token_medico', body.token);"] } }]
        },
        {
          "name": "Login enfermeiro",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{enfermeiro_username}}\",\n  \"senha\": \"{{enfermeiro_password}}\"\n}" },
            "url": "{{base_url_scheduling}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token_enfermeiro', pm.response.json().token);"] } }]
        },
        {
          "name": "Login paciente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{paciente_username}}\",\n  \"senha\": \"{{paciente_password}}\"\n}" },
            "url": "{{base_url_scheduling}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('token_paciente', pm.response.json().token);"] } }]
        },
        {
          "name": "Login com credenciais invalidas",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"medico\",\n  \"senha\": \"senha-errada\"\n}" },
            "url": "{{base_url_scheduling}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Cadastrar novo paciente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"paciente-novo-{{$timestamp}}\",\n  \"senha\": \"NovoPaciente@123\",\n  \"role\": \"PACIENTE\"\n}" },
            "url": "{{base_url_scheduling}}/users"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "pm.test('id retornado', () => pm.expect(pm.response.json().id).to.exist);", "pm.test('role PACIENTE', () => pm.expect(pm.response.json().role).to.eql('PACIENTE'));"] } }]
        }
      ]
    },
    {
      "name": "Scheduling",
      "item": [
        {
          "name": "Criar consulta como medico",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_medico}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": \"{{paciente_id}}\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"dataHoraInicio\": \"2026-06-10T14:00:00-03:00\",\n  \"dataHoraFim\": \"2026-06-10T14:30:00-03:00\",\n  \"motivo\": \"Retorno clinico\"\n}" },
            "url": "{{base_url_scheduling}}/consultas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "pm.test('resposta contem id', () => pm.expect(pm.response.json().id).to.exist);", "pm.environment.set('consulta_id', pm.response.json().id);", "pm.collectionVariables.set('consulta_id', pm.response.json().id);"] } }]
        },
        {
          "name": "Criar consulta como enfermeiro",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_enfermeiro}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": \"{{paciente_id}}\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"dataHoraInicio\": \"2026-06-12T10:00:00-03:00\",\n  \"dataHoraFim\": \"2026-06-12T10:30:00-03:00\",\n  \"motivo\": \"Consulta de acompanhamento\"\n}" },
            "url": "{{base_url_scheduling}}/consultas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));", "pm.test('status AGENDADA', () => pm.expect(pm.response.json().status).to.eql('AGENDADA'));"] } }]
        },
        {
          "name": "Alterar consulta como medico",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_medico}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"dataHoraInicio\": \"2026-06-11T09:00:00-03:00\",\n  \"dataHoraFim\": \"2026-06-11T09:30:00-03:00\",\n  \"status\": \"REMARCADA\",\n  \"motivo\": \"Remarcacao solicitada pelo paciente\"\n}" },
            "url": "{{base_url_scheduling}}/consultas/{{consulta_id}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('status REMARCADA', () => pm.expect(pm.response.json().status).to.eql('REMARCADA'));"] } }]
        },
        {
          "name": "Editar historico clinico como medico",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_medico}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"observacoesClinicas\": \"Paciente orientado a manter medicacao prescrita.\"\n}" },
            "url": "{{base_url_scheduling}}/consultas/{{consulta_id}}/historico"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('observacao persistida', () => pm.expect(pm.response.json().observacoesClinicas).to.exist);"] } }]
        }
      ]
    },
    {
      "name": "History GraphQL",
      "item": [
        {
          "name": "Historico completo como medico",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_medico}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query HistoricoPaciente($pacienteId: ID!, $filtro: HistoricoFiltro) { historicoPaciente(pacienteId: $pacienteId, filtro: $filtro) { id pacienteId medicoId dataHoraInicio status motivo observacoesClinicas } }\",\n  \"variables\": {\n    \"pacienteId\": \"{{paciente_id}}\",\n    \"filtro\": \"TODAS\"\n  }\n}" },
            "url": "{{base_url_history}}/graphql"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('historico retornado', () => pm.expect(pm.response.json().data.historicoPaciente).to.be.an('array'));"] } }]
        },
        {
          "name": "Consultas futuras como enfermeiro",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_enfermeiro}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query HistoricoPaciente($pacienteId: ID!, $filtro: HistoricoFiltro) { historicoPaciente(pacienteId: $pacienteId, filtro: $filtro) { id dataHoraInicio status } }\",\n  \"variables\": {\n    \"pacienteId\": \"{{paciente_id}}\",\n    \"filtro\": \"FUTURAS\"\n  }\n}" },
            "url": "{{base_url_history}}/graphql"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('futuras retornadas', () => pm.expect(pm.response.json().data.historicoPaciente).to.be.an('array'));"] } }]
        },
        {
          "name": "Minhas consultas como paciente",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_paciente}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query MinhasConsultas($filtro: HistoricoFiltro) { minhasConsultas(filtro: $filtro) { id pacienteId dataHoraInicio status } }\",\n  \"variables\": {\n    \"filtro\": \"TODAS\"\n  }\n}" },
            "url": "{{base_url_history}}/graphql"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));", "pm.test('minhas consultas retornadas', () => pm.expect(pm.response.json().data.minhasConsultas).to.be.an('array'));"] } }]
        },
        {
          "name": "Paciente tenta consultar outro paciente",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_paciente}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"query HistoricoPaciente($pacienteId: ID!, $filtro: HistoricoFiltro) { historicoPaciente(pacienteId: $pacienteId, filtro: $filtro) { id pacienteId } }\",\n  \"variables\": {\n    \"pacienteId\": \"{{outro_paciente_id}}\",\n    \"filtro\": \"TODAS\"\n  }\n}" },
            "url": "{{base_url_history}}/graphql"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 200 com erro GraphQL', () => pm.response.to.have.status(200));", "pm.test('erro de autorizacao retornado', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"] } }]
        }
      ]
    },
    {
      "name": "Negative Tests",
      "item": [
        {
          "name": "Criar consulta como paciente deve falhar",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_paciente}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": \"{{paciente_id}}\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"dataHoraInicio\": \"2026-06-15T14:00:00-03:00\"\n}" },
            "url": "{{base_url_scheduling}}/consultas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Alterar consulta como paciente deve falhar",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_paciente}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"CANCELADA\"\n}" },
            "url": "{{base_url_scheduling}}/consultas/{{consulta_id}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Editar historico como enfermeiro deve falhar",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_enfermeiro}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"observacoesClinicas\": \"Tentativa sem permissao.\"\n}" },
            "url": "{{base_url_scheduling}}/consultas/{{consulta_id}}/historico"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Sem token deve retornar 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": \"{{paciente_id}}\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"dataHoraInicio\": \"2026-06-20T14:00:00-03:00\"\n}" },
            "url": "{{base_url_scheduling}}/consultas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Token invalido deve retornar 401",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "token-invalido-abc123", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pacienteId\": \"{{paciente_id}}\",\n  \"medicoId\": \"{{medico_id}}\",\n  \"dataHoraInicio\": \"2026-06-20T14:00:00-03:00\"\n}" },
            "url": "{{base_url_scheduling}}/consultas"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    }
  ]
}
