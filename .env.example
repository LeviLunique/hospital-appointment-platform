# =============================================================================
# Hospital Appointment Platform - .env.example
# -----------------------------------------------------------------------------
# Copie este arquivo para .env na raiz do projeto e ajuste o que precisar:
#
#     cp .env.example .env
#
# O Docker Compose carrega .env automaticamente. Variaveis sensiveis
# (JWT_SECRET, senhas) DEVEM ser trocadas em ambientes nao locais.
# =============================================================================

# ---- Container names --------------------------------------------------------
SCHEDULING_DB_CONTAINER_NAME=scheduling-db
HISTORY_DB_CONTAINER_NAME=history-db
NOTIFICATION_DB_CONTAINER_NAME=notification-db
KAFKA_CONTAINER_NAME=kafka
KAFKA_UI_CONTAINER_NAME=kafka-ui
SCHEDULING_CONTAINER_NAME=scheduling-service
HISTORY_CONTAINER_NAME=history-service
NOTIFICATION_CONTAINER_NAME=notification-service

# ---- Service ports (host) ---------------------------------------------------
SCHEDULING_SERVICE_PORT=8080
HISTORY_SERVICE_PORT=8081
NOTIFICATION_SERVICE_PORT=8082

# ---- PostgreSQL host ports --------------------------------------------------
SCHEDULING_DB_HOST_PORT=5432
HISTORY_DB_HOST_PORT=5433
NOTIFICATION_DB_HOST_PORT=5434
POSTGRES_CONTAINER_PORT=5432

# ---- Scheduling PostgreSQL --------------------------------------------------
SCHEDULING_DB_NAME=schedulingdb
SCHEDULING_DB_USER=scheduling
SCHEDULING_DB_PASSWORD=change-me
SCHEDULING_DATASOURCE_URL=jdbc:postgresql://scheduling-db:5432/schedulingdb

# ---- History PostgreSQL -----------------------------------------------------
HISTORY_DB_NAME=historydb
HISTORY_DB_USER=history
HISTORY_DB_PASSWORD=change-me
HISTORY_DATASOURCE_URL=jdbc:postgresql://history-db:5432/historydb

# ---- Notification PostgreSQL ------------------------------------------------
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=change-me
NOTIFICATION_DATASOURCE_URL=jdbc:postgresql://notification-db:5432/notificationdb

# ---- Kafka ------------------------------------------------------------------
KAFKA_IMAGE=apache/kafka:3.9.1
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8090
KAFKA_TOPIC_CONSULTA_CRIADA=hospital.consultas.criadas.v1
KAFKA_TOPIC_CONSULTA_ALTERADA=hospital.consultas.alteradas.v1
KAFKA_TOPIC_CONSULTA_DLT=hospital.consultas.dlt

# ---- Kafka broker config (KRaft mode) ---------------------------------------
KAFKA_NODE_ID=0
KAFKA_PROCESS_ROLES=controller,broker
KAFKA_CONTROLLER_QUORUM_VOTERS=0@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:9094
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092,EXTERNAL://localhost:9094
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# ---- Kafka UI ---------------------------------------------------------------
KAFKA_UI_CLUSTER_NAME=local

# ---- JWT (compartilhado entre scheduling-service e history-service) ---------
# Gere um segredo forte em base64. Exemplo:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-base64-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# ---- Postman / Newman defaults ----------------------------------------------
NEWMAN_PLATFORM=linux/amd64
BASE_URL_SCHEDULING=http://scheduling-service:8080/api/v1
BASE_URL_SCHEDULING_ROOT=http://scheduling-service:8080
BASE_URL_HISTORY=http://history-service:8081
BASE_URL_NOTIFICATION=http://notification-service:8082

# ---- Seed users usados pela collection Postman e pelas migrations Flyway ----
# Senhas correspondem aos hashes BCrypt embutidos nas migrations V1.
# Em produção, troque o seed por usuarios cadastrados via POST /api/v1/users.
MEDICO_USERNAME=medico
MEDICO_PASSWORD=Medico@123
ENFERMEIRO_USERNAME=enfermeiro
ENFERMEIRO_PASSWORD=Enfermeiro@123
PACIENTE_USERNAME=paciente
PACIENTE_PASSWORD=Paciente@123
PACIENTE_ID=7a3f2f0a-2c1f-4f0a-9368-2d9dbd6e8e44
MEDICO_ID=4d2f88ef-8b8a-4d9a-a96f-808b1774bc2f
OUTRO_PACIENTE_ID=11111111-1111-4111-8111-111111111111
